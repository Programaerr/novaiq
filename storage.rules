rules_version = '2';

// قواعد Firebase Storage — تُنشر مرة واحدة من الكونسول أو عبر Firebase CLI.
//
// الملف الوحيد المخزَّن هنا هو نسخة PDF مجمَّدة من كل عقد لحظة اعتماده (lib/contractArchive.ts).
// لا يوجد رفع من العملاء إطلاقاً: الكتابة للأدمن فقط، والقراءة كذلك.
//
// لماذا القراءة للأدمن لا لصاحب العقد: مسار الملف هو رقم العقد، وقاعدة Storage لا تستطيع قراءة
// مستند العقد لتتحقق من ملكيته (هذه قدرة قواعد Firestore وحدها). فبدل قاعدة تخمّن الملكية،
// يصل العميل إلى نسخته عبر رابط التنزيل الموقَّع الذي يُحفظ في عقده — والعقد لا يقرؤه إلا هو.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /contracts/{contractFile} {
      allow read, write: if isAdmin();
    }

    // كل ما عدا ذلك مرفوض صراحةً — لا مسار مفتوح بالخطأ.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
