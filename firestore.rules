rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /contracts/{document=**} {
      allow read, write: if true;
    }

    // Live price overrides for the public catalogue: everyone needs to read these (any
    // visitor browsing templates), but only the signed-in admin may change a price.
    match /pricing_overrides/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin sign-up invite codes: a document's ID is itself the secret. `get` (fetch by
    // exact ID) is allowed so sign-up can check "does this code exist"; `list` is denied so
    // the set of valid codes can never be enumerated by scanning the collection — only
    // someone who already has the exact code from the owner can ever read it. Only a
    // signed-in admin can create new codes (the very first one is created once, manually,
    // in the Firebase Console).
    match /admin_invites/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // Anonymous usage analytics: any visitor may log an event (write-only ingestion),
    // but only the signed-in admin (see src/lib/auth.ts) can read the log back — that's
    // what the admin dashboard's analytics panel needs.
    match /analytics_events/{document=**} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
