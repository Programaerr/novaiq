rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // صحيحة فقط لصاحب/شريك الموقع — العملاء العاديون لهم حسابات أيضاً الآن (انظر
    // src/lib/auth.ts)، لذا "مسجّل دخول" وحدها لم تعد تعني "أدمن". كل قاعدة أدناه خاصة
    // بالأدمن تتحقق من هذه بدلاً من مجرد request.auth != null.
    //
    // .lower() مهمة: كل مستند أدمن يُنشأ (ويُتحقق منه في المتصفح) عبر normalizeEmail() في
    // src/lib/auth.ts، التي تحوّل إلى أحرف صغيرة أولاً. request.auth.token.email لا
    // يُحوَّل تلقائياً إلى أحرف صغيرة بواسطة Firebase Auth — بريد إلكتروني بأي حرف كبير
    // (مثل "Ahmed@Gmail.com") كان سيبحث عن admins/Ahmed@Gmail.com هنا، وهذا لا يوجد أبداً
    // (فقط admins/ahmed@gmail.com موجود)، فكانت هذه دائماً تُقيَّم إلى false وكانت كل
    // كتابة أدمن تفشل بصمت لذلك الحساب بينما كان الفحص من جهة العميل (الذي يُحوّل فعلاً)
    // لا يزال يُظهر له لوحة التحكم الكاملة كأدمن.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // تحمل العقود بيانات مالية/شخصية حقيقية لعملاء — كانت سابقاً "if true" لكل عملية،
    // بمعنى أن أي زائر، مسجّلاً أو لا، يقدر يقرأ أو يعدّل أو يحذف عقد أي عميل (بما فيه
    // سعره) مباشرة من المتصفح. إنشاء العقد محجوب خلف تسجيل الدخول (ContractBuilderGate.tsx)،
    // فكل عقد الآن يحمل `uid` مُنشئه؛ عقد من قبل وجود هذا الحقل يعود للمطابقة عبر بريد
    // الحساب الإلكتروني (بدون حساسية لحالة الأحرف، بنفس تطبيع isAdmin()). العملاء يقرؤون
    // فقط عقودهم هم وينشئون عقوداً جديدة (انظر CustomerDashboard.tsx — عرض وتنزيل PDF
    // فقط)؛ كل تعديل إضافي (الحالة، السعر النهائي، ملاحظات الأدمن، الحذف) يحدث حصراً من
    // AdminDashboard.tsx، لذا update وdelete للأدمن فقط.
    match /contracts/{contractId} {
      function ownsContract() {
        return request.auth != null && (
          resource.data.uid == request.auth.uid ||
          (!('uid' in resource.data) && resource.data.email.lower() == request.auth.token.email.lower())
        );
      }
      // ليس لدى Firestore تحكّم بمستوى الحقل: "create" إما كله أو لا شيء، فقاعدة تتحقق فقط
      // من الملكية تسمح لعميل مسجّل دخول بأن يعطينا عقداً يحمل أصلاً توقيعنا المضاد، أو
      // حالة معتمَدة، أو رصيداً مدفوعاً، أو ملاحظة أدمن. كل حقل أدناه يُكتب حصراً من
      // AdminDashboard/ContractsTab، فلا يوجد لأي منها أي مبرر ليكون موجوداً في المستند
      // الذي ينشئه عميل — الحالة الأولية المشروعة الوحيدة هي 'submitted' التي يضبطها
      // ContractBuilder.
      //
      // totalPriceIQD غير مُتحقَّق منه هنا عمداً. التحقق منه يعني إعادة حسابه من كتالوج
      // القوالب وإضافاتها، وذلك الكتالوج يعيش في كود التطبيق، لا في Firestore — القاعدة لا
      // تقدر تقرأه. هذا الفحص مكانه على السيرفر؛ وحتى يوجد، يلتقط الأدمن أي سعر خاطئ
      // ويضبط الرقم النهائي بنفسه على أي حال.
      function customerCreateIsClean() {
        let d = request.resource.data;
        return d.status == 'submitted'
          // العقد يُنسب إلى بريد الحساب الموقّع نفسه، لا إلى بريد يكتبه من ينشئه: بدون هذا
          // يقدر أي عميل مسجّل دخول ينشئ عقداً باسم بريد شخص آخر، فيظهر في لوحة التحكم كأنه
          // منه. النموذج أصلاً يعبّئ بريد الحساب ولا يسمح بتعديله (ContractBuilder.tsx).
          && d.email is string && d.email.lower() == request.auth.token.email.lower()
          // أحجام وأنواع الحقول النصية. Firestore يقبل حتى 1MB للمستند الواحد، وبدون سقوف
          // هنا يقدر حساب واحد يملأ المجموعة بمستندات ضخمة أو بأنواع غير متوقَّعة تكسر
          // لوحة التحكم عند عرضها.
          && d.companyName is string && d.companyName.size() > 0 && d.companyName.size() < 300
          && d.repName is string && d.repName.size() > 0 && d.repName.size() < 300
          && d.phone is string && d.phone.size() > 0 && d.phone.size() < 40
          && d.templateTitle is string && d.templateTitle.size() < 400
          && d.customFeaturesText is string && d.customFeaturesText.size() < 20000
          // موقع إلكتروني أو تطبيق هاتف حصراً. مكتوبة كـ"إن وُجد" لأن عقداً أنشأه متصفح
          // يحمل نسخة قديمة من الكود (قبل وجود الحقل) يجب أن يبقى قابلاً للإنشاء.
          && (!('projectType' in d) || d.projectType in ['website', 'app'])
          && !('companySignatureDataUrl' in d)
          && !('completedAt' in d)
          // حقلان يكتبهما الأدمن وحده: رابط المعاينة (يظهر للعميل كزر قابل للضغط) وساعة بدء
          // التنفيذ (أساس حساب نسبة الإنجاز). عميل يقدر يكتبهما بنفسه كان يقدر يزرع رابطاً
          // في حسابه أو يزوّر نسبة تقدّم مشروعه.
          && !('previewUrl' in d)
          && !('developmentStartedAt' in d)
          && !('adminNotes' in d)
          && !('costIQD' in d)
          && !('paymentStatus' in d)
          && !('paidAmountIQD' in d)
          && !('payments' in d)
          && !('installmentsPlanned' in d);
      }

      allow read: if isAdmin() || ownsContract();
      allow create: if isAdmin() ||
        (request.auth != null
          && request.resource.data.uid == request.auth.uid
          && customerCreateIsClean());
      allow update, delete: if isAdmin();
    }

    // قائمة الأدمن المسموح بهم: مُعرِّف المستند هو بريد الأدمن الإلكتروني؛ محتواه لا يهم،
    // فقط وجوده. `get` (جلب بمُعرِّف دقيق) مفتوح لأي مستخدم مسجّل دخول بحيث يقدر التطبيق
    // يتحقق "هل أنا أدمن؟"؛ `list` ممنوعة بحيث لا يمكن أبداً اكتشاف مجموعة بريدات الأدمن
    // عبر مسح القائمة. فقط أدمن موجود يقدر يضيف آخر — الأدمن الأول الوحيد يُنشأ مرة واحدة،
    // يدوياً، من Firebase Console.
    match /admins/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if isAdmin();
    }

    // نسخة قابلة للاستعلام من المتصفح لكل حساب مسجّل دخول (تُكتب بواسطة src/lib/auth.ts
    // عند كل دخول). تتيح للوحات تحكم Subscribers/Team أن تسرد حسابات حقيقية مباشرة من
    // Firestore، دون الحاجة لمفتاح حساب خدمة Admin SDK. فقط المستخدم المسجّل دخوله يقدر
    // يكتب مستنده هو؛ فقط الأدمن يقدر يسرد الدليل الكامل — يجب ألا يقدر عميل عادي أبداً
    // يعدّد بريد/صورة كل عميل آخر.
    match /users/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // تعديلات الأسعار الحية للكتالوج العام: كل زائر يحتاج يقرأها (أي زائر يتصفح القوالب)،
    // لكن فقط الأدمن يقدر يغيّر سعراً.
    match /pricing_overrides/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // إعدادات الموقع العامة (حالياً فقط روابط التواصل الاجتماعي/واتساب الظاهرة في
    // الفوتر) — نفس شكل pricing_overrides: قراءة عامة لأن صفحة كل زائر تعرضها، كتابة
    // للأدمن فقط.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // رسائل نموذج "المراسلة والدعم" (ContactSection.tsx) — لم يكن لهذه المجموعة أي قاعدة
    // إطلاقاً، فكان الرفض الافتراضي في Firestore يمنع كل إرسال: كل زائر يملأ النموذج كان
    // يرى رسالة "ما انرسلت الرسالة" دائماً، بصمت، دون أي علاقة بصحة البيانات التي كتبها.
    //
    // النموذج عام عمداً (لا حاجة لتسجيل دخول لإرسال رسالة، تماماً كصفحة تواصل عادية)، لذا
    // `create` مفتوحة للجميع — لكن مقيَّدة بشكل الحقول التي يكتبها ContactSection.tsx
    // فعلاً، بحيث لا يقدر أحد يستغل الفتحة العامة ليكتب مستنداً عشوائياً بحقول أو حجم غير
    // متوقَّع. لا يوجد حالياً أي عرض إداري لهذه الرسائل في التطبيق، فـ`read`/`update`/
    // `delete` أدمن فقط تحسّباً — خاصة رسائل عملاء محتملين لا يجب أن تكون قابلة للقراءة
    // من أي زائر آخر.
    match /contact_messages/{messageId} {
      function contactMessageIsClean() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'phone', 'message', 'language', 'createdAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() < 200
          && d.phone is string && d.phone.size() > 0 && d.phone.size() < 40
          && d.message is string && d.message.size() > 0 && d.message.size() < 5000
          && d.language is string;
      }

      allow create: if contactMessageIsClean();
      allow read, update, delete: if isAdmin();
    }

    // ملاحظات الأدمن الخاصة بكل عميل (شخص، لا عقد واحد) — مُعرِّف المستند هو uid حساب العميل
    // نفسه، ويُقرأ ويُكتب حصراً من ملفه الشخصي في لوحة التحكم (CustomerProfileSheet.tsx).
    //
    // مجموعة منفصلة عمداً عن `users/{uid}` بدل إضافة حقل عليها مباشرة: تلك المجموعة مرآة
    // يكتبها الحساب نفسه فقط عند كل دخول (src/lib/auth.ts) — لو سمحنا للأدمن بالكتابة على
    // نفس المستند، أي خطأ بسيط في الكود قد يكتب فوق displayName/email/photoURL الحقيقية
    // لحساب العميل. هذه مجموعة أدمن فقط بالكامل، ولا علاقة لها بما يكتبه العميل عن نفسه.
    match /customer_notes/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
