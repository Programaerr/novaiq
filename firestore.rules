rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only for the owner/partner — regular customers also have accounts now (see
    // src/lib/auth.ts), so "signed in" alone no longer implies "admin". Every admin-only
    // rule below checks this instead of just request.auth != null.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /contracts/{document=**} {
      allow read, write: if true;
    }

    // Admin allowlist: a document's ID is the admin's email; its content doesn't matter,
    // only its existence. `get` (fetch by exact ID) is open to any signed-in user so the
    // app can check "am I an admin?"; `list` is denied so the set of admin emails can never
    // be discovered by scanning. Only an existing admin can add another — the very first
    // one is created once, manually, in the Firebase Console.
    match /admins/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Client-queryable mirror of every signed-in account (written by src/lib/auth.ts on
    // each login). Lets the Subscribers/Team admin panels list real accounts straight from
    // Firestore, with no Admin SDK service account key required. Only the signed-in user
    // may write their own doc; only an admin may list the full directory — a regular
    // customer must never be able to enumerate every other customer's email/photo.
    match /users/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Live price overrides for the public catalogue: everyone needs to read these (any
    // visitor browsing templates), but only an admin may change a price.
    match /pricing_overrides/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anonymous usage analytics: any visitor may log an event (write-only ingestion),
    // but only an admin can read the log back — that's what the dashboard's analytics
    // panel needs.
    match /analytics_events/{document=**} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
