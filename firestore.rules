rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only for the owner/partner — regular customers also have accounts now (see
    // src/lib/auth.ts), so "signed in" alone no longer implies "admin". Every admin-only
    // rule below checks this instead of just request.auth != null.
    //
    // .lower() matters: every admin doc is created (and checked client-side) via
    // normalizeEmail() in src/lib/auth.ts, which lowercases first. request.auth.token.email
    // is NOT lowercased by Firebase Auth — a token email with any uppercase character
    // (e.g. "Ahmed@Gmail.com") would look up admins/Ahmed@Gmail.com here, which never
    // exists (only admins/ahmed@gmail.com does), so this always evaluated to false and
    // every admin write silently failed for that account while the client-side check
    // (which does lowercase) still showed them the full dashboard as an admin.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Contracts hold real customer financial/personal data — previously "if true" for
    // every operation, meaning any visitor, signed in or not, could read/edit/delete any
    // customer's contract (including its price) straight from the browser. Contract
    // creation is gated behind login (ContractBuilderGate.tsx), so every contract now
    // carries its creator's `uid`; a contract from before that field existed falls back to
    // matching the account's email (case-insensitively, same normalization as isAdmin()).
    // Customers only ever read their own contracts and create new ones (see
    // CustomerDashboard.tsx — view + PDF download only); every further edit (status, final
    // price, admin notes, deletion) happens exclusively from AdminDashboard.tsx, so update
    // and delete are admin-only.
    match /contracts/{contractId} {
      function ownsContract() {
        return request.auth != null && (
          resource.data.uid == request.auth.uid ||
          (!('uid' in resource.data) && resource.data.email.lower() == request.auth.token.email.lower())
        );
      }
      // Firestore has no field-level write control: "create" is all-or-nothing, so a rule that
      // only checks ownership lets a signed-in customer hand us a contract that already carries
      // our countersignature, an approved status, a paid balance, or an admin note. Every field
      // below is written exclusively by AdminDashboard/ContractsTab, so none of them has any
      // business being present on the document a customer creates — the only legitimate initial
      // status is the 'submitted' that ContractBuilder sets.
      //
      // totalPriceIQD is deliberately NOT checked here. Validating it means recomputing it from
      // the template catalogue and its add-ons, and that catalogue lives in application code,
      // not in Firestore — a rule cannot read it. That check belongs on the server; until it
      // exists, a wrong price is caught by the admin, who sets the final figure anyway.
      function customerCreateIsClean() {
        let d = request.resource.data;
        return d.status == 'submitted'
          && !('companySignatureDataUrl' in d)
          && !('completedAt' in d)
          && !('adminNotes' in d)
          && !('costIQD' in d)
          && !('paymentStatus' in d)
          && !('paidAmountIQD' in d)
          && !('payments' in d)
          && !('installmentsPlanned' in d);
      }

      allow read: if isAdmin() || ownsContract();
      allow create: if isAdmin() ||
        (request.auth != null
          && request.resource.data.uid == request.auth.uid
          && customerCreateIsClean());
      allow update, delete: if isAdmin();
    }

    // Admin allowlist: a document's ID is the admin's email; its content doesn't matter,
    // only its existence. `get` (fetch by exact ID) is open to any signed-in user so the
    // app can check "am I an admin?"; `list` is denied so the set of admin emails can never
    // be discovered by scanning. Only an existing admin can add another — the very first
    // one is created once, manually, in the Firebase Console.
    match /admins/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Client-queryable mirror of every signed-in account (written by src/lib/auth.ts on
    // each login). Lets the Subscribers/Team admin panels list real accounts straight from
    // Firestore, with no Admin SDK service account key required. Only the signed-in user
    // may write their own doc; only an admin may list the full directory — a regular
    // customer must never be able to enumerate every other customer's email/photo.
    match /users/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Live price overrides for the public catalogue: everyone needs to read these (any
    // visitor browsing templates), but only an admin may change a price.
    match /pricing_overrides/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site-wide settings (currently just the social/WhatsApp links shown in the footer) —
    // same shape as pricing_overrides: public read since every visitor's page renders them,
    // admin-only write.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
