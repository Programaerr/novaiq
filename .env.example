# ═══════════════════════════════════════════════════════════════════════════════════════
#  NUVAIQ — نموذج متغيّرات البيئة.
#
#  انسخ هذا الملف إلى `.env` واملأ القيم. `.env` مستثنى في .gitignore، وهذا الملف وحده
#  (`.env.example`) هو المتتبَّع في المستودع — فلا تضع فيه قيمة حقيقية أبداً.
#
#  ── القاعدة الوحيدة التي يجب ألّا تُخطئ فيها ───────────────────────────────────────────
#  كل متغيّر يبدأ بـ`VITE_` يُحقَن داخل ملفات JavaScript التي يُنزّلها **كل زائر**. ليس
#  مخفيّاً ولا مشفّراً — يفتح أدوات المطوّر ويقرأه. فما يبدأ بـ`VITE_` معلوم للعالم بحكم
#  التصميم، وما عداه لا يصل المتصفح إطلاقاً.
# ═══════════════════════════════════════════════════════════════════════════════════════


# ── ١) للمتصفح — عامّة بطبيعتها ────────────────────────────────────────────────────────
# هذان الاثنان يُبنيان داخل الموقع ويراهما الجميع، وهذا صحيح ومقصود: مفتاح anon لا يمنح
# صلاحية بذاته، بل يهوّي الطلب فقط. **ما يحميك فعلاً هو سياسات RLS** (supabase/02_policies.sql).
#
# ولهذا ترتيب واحد لا يجوز عكسه: نفّذ 01_schema.sql ثم 02_policies.sql **قبل** أن تدخل أي
# بيانات حقيقية. جدول بلا RLS مع مفتاح anon منشور = قاعدة مفتوحة للقراءة والكتابة للعالم.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=


# ── ٢) محلّي فقط — لا يُنشر ولا يُلصق في محادثة ─────────────────────────────────────────
# هذان يُستعملان من جهازك وحده: ترحيل البيانات، وربطي المباشر بالقاعدة للفحص.
#
# service_role **يتجاوز RLS بالكامل** — يقرأ ويكتب أي صف في أي جدول بلا استثناء. لا يوضع
# في متغيّر يبدأ بـVITE_، ولا في Netlify، ولا في أي مكان يصل المتصفح. لم يعد في هذا المشروع
# أي كود يعمل على خادم بعد حذف الدوال السحابية، فمكانه الوحيد المشروع هو جهازك أثناء الترحيل.
SUPABASE_SERVICE_ROLE_KEY=

# سلسلة الاتصال المباشر بـPostgres (Project Settings ← Database ← Connection string).
# تحمل كلمة مرور القاعدة بداخلها، فهي سرّ كامل.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres


# ── ٣) خادم التطوير المحلّي (server.ts) ────────────────────────────────────────────────
# عدد وسطاء الشبكة أمام الخادم المحلّي. صفر ما لم تضعه خلف بروكسي.
TRUST_PROXY_HOPS=0


# ── ملاحظة: `FIREBASE_SERVICE_ACCOUNT_PATH` لم يعد له وجود ─────────────────────────────
# كان يقرأه server.ts ليشغّل Firebase Admin SDK للمسارات الإدارية. حُذفت تلك المسارات
# والحزمة معها مع التخلّص من الدوال السحابية، فاحذف السطر من `.env` المحلّي لديك — بقاؤه
# يوحي بأن هناك ما يقرؤه.
