# VITE_* تُحزَم داخل ملفات المتصفح — يقرأها أي زائر. ما يحميك هو RLS لا المفتاح.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# محلّي فقط. service_role يتجاوز RLS بالكامل — لا يُنشر ولا يأخذ بادئة VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

TRUST_PROXY_HOPS=0
