# graphify-out/ moved to .gitignore entirely (untracked can't conflict, full stop) — no merge
# attribute needed for it here anymore.
#
# package-lock.json is different from graphify-out in one important way: it isn't disposable.
# A conflict there usually means the other person genuinely added/updated a dependency, and
# silently keeping "our" side (merge=ours) would hide that change rather than just avoid noise
# — the machine that kept its stale lockfile would then be missing a package with no warning.
# So this stays plain: -merge just flags the conflict instead of splicing it line-by-line, and
# the pre-commit hook below stops that flagged state from ever being auto-committed. Resolving
# it correctly is just: take theirs, then `npm install` to regenerate cleanly.
package-lock.json -merge

# Shell hooks must keep LF endings on every platform — a CRLF shebang line can fail to execute
# under Git Bash / WSL, silently turning the safety hook below into a no-op.
.githooks/* text eol=lf
